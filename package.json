{
  "name": "@bokijonovm/cursorcrew",
  "version": "0.1.1",
  "description": "Your page, built live by a crew of multiplayer cursors. Zero dependencies.",
  "keywords": [
    "animation",
    "cursor",
    "multiplayer",
    "page-load",
    "intro",
    "typing",
    "reveal",
    "react"
  ],
  "homepage": "https://cursorcrew.vercel.app/",
  "bugs": "https://github.com/BokijonovM/cursorcrew/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BokijonovM/cursorcrew.git"
  },
  "license": "MIT",
  "author": "Muhsinjon Bokijonov",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/cursorcrew.global.js",
  "jsdelivr": "./dist/cursorcrew.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsup",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "publint && attw --pack . --profile node16",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run check:package"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
